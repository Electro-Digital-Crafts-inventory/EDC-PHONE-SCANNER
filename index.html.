
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>EDC Barcode Scanner</title>

  <script src="https://unpkg.com/html5-qrcode"></script>

  <style>
    body {
      font-family: Arial, sans-serif;
      max-width: 480px;
      margin: 0 auto;
      padding: 24px 16px;
      background: #f5f5f5;
      color: #222;
    }

    main {
      background: white;
      padding: 20px;
      border-radius: 16px;
    }

    h1 { margin-top: 0; font-size: 25px; }

    p { line-height: 1.5; }

    button {
      width: 100%;
      padding: 14px;
      margin-top: 10px;
      border: 0;
      border-radius: 10px;
      font-size: 16px;
      cursor: pointer;
    }

    #start { background: #176b45; color: white; }
    #stop { background: #e8e8e8; color: #222; }

    #reader { width: 100%; margin-top: 16px; }

    #result {
      padding: 12px;
      background: #f0f0f0;
      border-radius: 8px;
      overflow-wrap: anywhere;
    }

    .note { color: #555; font-size: 14px; }
  </style>
</head>

<body>
  <main>
    <h1>EDC Barcode Scanner</h1>
    <p>Scan a product barcode using your phone's back camera.</p>

    <button id="start" type="button">Start Camera</button>
    <button id="stop" type="button">Stop Camera</button>

    <div id="reader"></div>

    <h3>Scanned barcode</h3>
    <p id="result">No barcode scanned yet.</p>

    <p class="note">
      Test mode only. This page does not record sales or change inventory.
    </p>
  </main>

  <script>
    let scanner = null;
    let running = false;
    let lastBarcode = "";

    const result = document.getElementById("result");

    document.getElementById("start").addEventListener("click", async () => {
      if (running) return;

      result.textContent = "Requesting camera access...";

      try {
        if (!window.isSecureContext) {
          throw new Error("Open this page through its HTTPS GitHub Pages address.");
        }

        if (!navigator.mediaDevices?.getUserMedia) {
          throw new Error("Camera access is unavailable in this browser context.");
        }

        const cameras = await Html5Qrcode.getCameras();

        if (!cameras.length) {
          throw new Error("No camera was detected.");
        }

        scanner = new Html5Qrcode("reader");

        const backCamera =
          cameras.find(c => /back|rear|environment/i.test(c.label)) ||
          cameras[cameras.length - 1];

        await scanner.start(
          backCamera.id,
          {
            fps: 10,
            qrbox: { width: 280, height: 120 },
            aspectRatio: 1.5,
            formatsToSupport: [
              Html5QrcodeSupportedFormats.EAN_13,
              Html5QrcodeSupportedFormats.EAN_8,
              Html5QrcodeSupportedFormats.UPC_A,
              Html5QrcodeSupportedFormats.UPC_E,
              Html5QrcodeSupportedFormats.CODE_128,
              Html5QrcodeSupportedFormats.CODE_39,
              Html5QrcodeSupportedFormats.ITF,
              Html5QrcodeSupportedFormats.QR_CODE
            ]
          },
          (decodedText) => {
            if (decodedText === lastBarcode) return;
            lastBarcode = decodedText;
            result.textContent = decodedText;
          },
          () => {}
        );

        running = true;
        result.textContent = "Camera running. Point it at a barcode.";
      } catch (error) {
        result.textContent = "Camera error: " + error.message;
      }
    });

    document.getElementById("stop").addEventListener("click", async () => {
      if (scanner && running) {
        try {
          await scanner.stop();
          await scanner.clear();
        } catch (error) {
          console.error(error);
        }
      }

      scanner = null;
      running = false;
      lastBarcode = "";
      result.textContent = "Camera stopped. No inventory changes were made.";
    });
  </script>
</body>
</html>
